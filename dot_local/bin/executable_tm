#!/usr/bin/env bash
# Open a tmux session for a project directory or an SSH host.
#
#   tm           pick from existing sessions, SSH hosts and zoxide's directories
#                (Ctrl-F in the picker searches every directory under $HOME)
#   tm <query>   SSH host <query> if it's a known one, else the best zoxide match
#
# Directory sessions are named after the directory; SSH sessions after the host
# and close when the connection ends. Attaches from outside tmux and switches
# the client from inside it.
set -euo pipefail

# Hosts to leave out: they're for git, not for logging in.
is_git_host() {
  [[ "$1" =~ (^|@)(github\.com|gitlab\.com)$ || "$1" == git@* ]]
}

# The user@hostname that ssh would actually connect to.
ssh_target() {
  ssh -G -- "$1" 2>/dev/null | awk '$1 == "user" { u = $2 } $1 == "hostname" { h = $2 } END { print u "@" h }'
}

# Whether a hostname resolves, giving up after half a second. macOS has neither
# getent nor timeout.
resolves() {
  if command -v getent >/dev/null && command -v timeout >/dev/null; then
    timeout 0.5 getent hosts "$1" >/dev/null
  else
    perl -MTime::HiRes=ualarm -e 'ualarm 500000; exit !gethostbyname($ARGV[0])' "$1" 2>/dev/null
  fi
}

# SSH destinations: ~/.ssh/config hosts first, then zsh history, most used
# first. History entries that a config host already covers, or whose hostname
# no longer resolves, are left out.
ssh_hosts() {
  # Newline-delimited, since macOS's bash 3.2 has no associative arrays.
  local seen=$'\n'
  local host target hostname

  if [[ -r ~/.ssh/config ]]; then
    while read -r host; do
      is_git_host "$host" && continue
      target=$(ssh_target "$host")
      [[ "$seen" == *$'\n'"$target"$'\n'* ]] && continue
      seen+="$target"$'\n'
      printf '%s\n' "$host"
    done < <(awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' ~/.ssh/config)
  fi

  [[ -r "${HISTFILE:-$HOME/.zsh_history}" ]] || return 0
  while read -r host; do
    is_git_host "$host" && continue
    target=$(ssh_target "$host")
    [[ "$seen" == *$'\n'"$target"$'\n'* ]] && continue
    seen+="$target"$'\n'
    hostname=${target#*@}
    if [[ ! "$hostname" =~ ^[0-9.]+$|: ]] && ! resolves "$hostname"; then
      continue
    fi
    printf '%s\n' "$host"
  done < <(
    sed -E 's/^: [0-9]+:[0-9]+;//' "${HISTFILE:-$HOME/.zsh_history}" |
      awk '$1 == "ssh" {
        # Skip options, and the values of options that take one.
        for (i = 2; i <= NF; i++) {
          if ($i ~ /^-[BbcDEeFIiJLlmOoPpQRSWw]$/) { i++; continue }
          if ($i ~ /^-/) continue
          print $i
          break
        }
      }' |
      sort | uniq -c | sort -rn | awk '{ print $2 }'
  )
}

# Every directory under $HOME, skipping hidden and gitignored ones.
all_dirs() {
  if command -v fd >/dev/null; then
    fd --type d . "$HOME"
  elif command -v fdfind >/dev/null; then
    fdfind --type d . "$HOME"
  else
    find "$HOME" -mindepth 1 -name '.*' -prune -o -type d -print 2>/dev/null
  fi | sed 's:/$::'
}

# The picker's default list: sessions, SSH hosts and zoxide's directories.
main_list() {
  tmux list-sessions -F 'session: #{session_name}' 2>/dev/null || true
  ssh_hosts | sed 's/^/ssh: /'
  zoxide query --list
}

# tmux doesn't allow . or : in session names
session_name() {
  tr '.:' '__' <<<"$1"
}

# When no tmux server is running, start one and let continuum restore the saved
# sessions before going on, so they're in the picker and the restore can't take
# over the session opened here. Resurrect's hooks (see ~/.tmux.conf) touch the
# marker files; polling them instead of tmux matters, because continuum skips
# the restore if it sees another tmux process.
wait_for_restore() {
  local saved marker i
  tmux list-sessions >/dev/null 2>&1 && return 0
  if [[ -d ~/.tmux/resurrect ]]; then
    saved=~/.tmux/resurrect/last
  else
    saved=${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect/last
  fi
  [[ -e "$saved" && ! -e ~/tmux_no_auto_restore ]] || return 0

  marker=${XDG_RUNTIME_DIR:-/tmp}/tm-restore-$UID
  rm -f "$marker.started" "$marker.done"
  # A server without sessions exits at once. Resurrect removes a session named 0
  # once it has restored the others.
  tmux new-session -d -s 0
  printf 'Restoring tmux sessions...' >&2
  # Continuum waits a second before it starts.
  for ((i = 0; i < 30; i++)); do
    [[ -e "$marker.started" ]] && break
    sleep 0.1
  done
  if [[ -e "$marker.started" ]]; then
    for ((i = 0; i < 300; i++)); do
      [[ -e "$marker.done" ]] && break
      sleep 0.1
    done
  fi
  printf '\r\033[K' >&2
  # No restore started, so the placeholder is still ours to remove.
  if [[ ! -e "$marker.started" ]]; then
    tmux kill-session -t =0 2>/dev/null || true
  fi
  rm -f "$marker.started" "$marker.done"
}

wait_for_restore

name="" dir="" host=""
if (( $# )); then
  if grep -qxF -- "$1" <<<"$(ssh_hosts)"; then
    host=$1
  else
    dir=$(zoxide query -- "$@")
  fi
else
  # Ctrl-F switches between the default list and every directory under $HOME,
  # keeping what's been typed so far.
  mode=main query=""
  while :; do
    if [[ "$mode" == main ]]; then
      list=main_list prompt='session> ' header='ctrl-f: search all directories'
    else
      list=all_dirs prompt='dir> ' header='ctrl-f: back to sessions'
    fi
    status=0
    out=$("$list" | fzf --height=40% --reverse --prompt="$prompt" --header="$header" \
      --print-query --query="$query" --expect=ctrl-f) || status=$?
    query=$(sed -n 1p <<<"$out")
    key=$(sed -n 2p <<<"$out")
    pick=$(sed -n 3p <<<"$out")
    if [[ "$key" == ctrl-f ]]; then
      [[ "$mode" == main ]] && mode=dirs || mode=main
      continue
    fi
    (( status == 0 )) && [[ -n "$pick" ]] || exit 0
    break
  done
  case "$mode:$pick" in
    "main:session: "*) name=${pick#session: } ;;
    "main:ssh: "*) host=${pick#ssh: } ;;
    *) dir=$pick ;;
  esac
fi

if [[ -n "$host" ]]; then
  name=$(session_name "$host")
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    # Keep the session open if ssh fails, so the error stays readable.
    tmux new-session -d -s "$name" \
      "ssh $(printf '%q' "$host") || { echo 'ssh failed; press Enter to close'; read _; }"
    # Show only the remote tmux: hide this one's status bar and move its prefix
    # to C-b so C-a reaches the remote (see the hooks in ~/.tmux.conf).
    tmux set -t "=$name:" status off \; set -t "=$name:" prefix C-b \; set -t "=$name:" @ssh on
  fi
elif [[ -n "$dir" ]]; then
  # Remember it, so it shows up in the default list next time.
  zoxide add -- "$dir" 2>/dev/null || true
  name=$(session_name "$(basename "$dir")")
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$dir"
  fi
fi

# On a fresh server, continuum's restore runs a moment after this and would
# leave the client on the saved session; its hook switches back to this one.
tmux set -g @tm_target "$name"
if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "=$name"
else
  tmux -u attach-session -t "=$name"
fi
