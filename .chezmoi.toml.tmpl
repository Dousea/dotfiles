{{- /* full: the complete setup (default).
       minimal: distro zsh plugins instead of zinit, no tmux plugins, no nvim
       config. */ -}}
{{- $choices := list "full" "minimal" -}}
{{- $profile := "full" -}}
{{- if has (get . "profile") $choices -}}
{{-   $profile = get . "profile" -}}
{{- else if stdinIsATTY -}}
{{-   $profile = promptChoice "Machine profile" $choices "full" -}}
{{- end -}}
[data]
  profile = {{ $profile | quote }}
