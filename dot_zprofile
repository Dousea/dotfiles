# Homebrew
[ -x "$(command -v brew)" ] && eval "$(brew shellenv)"

# Rust
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Mise
[ -x "$(command -v mise)" ] && eval "$(mise activate zsh)"

# pnpm
export PNPM_HOME="/home/orlando/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# PHP
export PATH="$HOME/.phpenv/bin:$PATH"
[ -x "$(command -v phpenv)" ] && eval "$(phpenv init -)"

# Runtime dir (needed in some cases for XDG compliance)
mkdir -p ~/.runtime
export XDG_RUNTIME_DIR=~/.runtime
chmod 777 $XDG_RUNTIME_DIR

# LuaRocks
[ -x "$(command -v luarocks)" ] && eval "$(luarocks path --bin)"

