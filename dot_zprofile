typeset -U path PATH
path=("$HOME/.local/bin" $path)

# Homebrew (macOS)
if [[ "$OSTYPE" == darwin* ]]; then
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
  unset brew_bin
fi

# mise shims for non-interactive programs; interactive shells run
# `mise activate` in .zshrc instead
[[ -d "$HOME/.local/share/mise/shims" ]] && path=("$HOME/.local/share/mise/shims" $path)

# Rust
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# pnpm
if [[ "$OSTYPE" == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
path=("$PNPM_HOME" $path)

# PHP
[[ -d "$HOME/.phpenv/bin" ]] && path=("$HOME/.phpenv/bin" $path)

# LuaRocks
(( $+commands[luarocks] )) && eval "$(luarocks path --bin)"

# SSH agent from Bitwarden desktop on Windows, relayed into WSL (see wsl-ssh-agent)
[[ -n "$WSL_DISTRO_NAME" && -x "$HOME/.local/bin/wsl-ssh-agent" ]] && eval "$("$HOME/.local/bin/wsl-ssh-agent")"
