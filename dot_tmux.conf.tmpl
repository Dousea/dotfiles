{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{-     $wsl = true -}}
{{-   end -}}
{{- end -}}
{{- /* Each machine gets its own status bar color, picked from its hostname. */ -}}
{{- $hostColors := list "colour39" "colour43" "colour76" "colour111" "colour141" "colour170" "colour208" "colour216" -}}
{{- $hostColor := index $hostColors (mod (atoi (adler32sum .chezmoi.hostname)) (len $hostColors)) -}}
{{ if ne .profile "minimal" -}}
# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-pain-control'
set -g @plugin 'MunifTanjim/tmux-mode-indicator'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'thewtex/tmux-mem-cpu-load'
set -g @plugin 'jlipps/tmux-safekill'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Save sessions every 15 minutes and restore them when the tmux server starts
set -g @continuum-restore 'on'

{{ end -}}
set-option -g default-command "${SHELL}"
set-option -g base-index 1
set-option -g renumber-windows on
# When a session ends (e.g. an SSH session from tm), switch to another one
# instead of detaching
set-option -g detach-on-destroy off

# Enable mouse!
set -g mouse on

# Enable 256 color support!
{{- if eq .chezmoi.os "darwin" }}
# macOS ships an ncurses without the tmux-256color terminfo entry.
set -g default-terminal "screen-256color"
{{- else }}
set -g default-terminal "tmux-256color"
{{- end }}
set -as terminal-features ",xterm-256color:RGB"
set -g allow-passthrough on
# Send copies to the outer terminal's clipboard (OSC 52), including from a
# tmux on a remote machine or nested inside this one
set -s set-clipboard on
set -g focus-events on

# Move between Neovim splits and tmux panes with Ctrl+h/j/k/l
# (smart-splits.nvim sets @pane-is-vim on panes running Neovim)
bind -n C-h if -F '#{@pane-is-vim}' { send-keys C-h } { select-pane -L }
bind -n C-j if -F '#{@pane-is-vim}' { send-keys C-j } { select-pane -D }
bind -n C-k if -F '#{@pane-is-vim}' { send-keys C-k } { select-pane -U }
bind -n C-l if -F '#{@pane-is-vim}' { send-keys C-l } { select-pane -R }
bind -T copy-mode-vi C-h select-pane -L
bind -T copy-mode-vi C-j select-pane -D
bind -T copy-mode-vi C-k select-pane -U
bind -T copy-mode-vi C-l select-pane -R

unbind C-b
set -g prefix C-a
bind C-a send-prefix

# F12 switches this tmux's keys off so everything, including the prefix, goes to
# a nested tmux (e.g. one over SSH). F12 again switches them back on.
bind -T root F12 \
  set prefix None \;\
  set key-table off \;\
  set status-style "fg=colour245,bg=colour236" \;\
  if -F '#{pane_in_mode}' 'send-keys -X cancel' \;\
  refresh-client -S
bind -T off F12 \
  set -u prefix \;\
  set -u key-table \;\
  set -u status-style \;\
  refresh-client -S

# tmux-yank detects pbcopy, wl-copy and xclip by itself; only WSL needs help.
set -g @yank_action 'copy-pipe'
{{- if $wsl }}
set -g @custom_copy_command '/mnt/c/Windows/System32/clip.exe'
bind-key -T copy-mode-vi p run "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -c [Console]::Out.Write($(Get-Clipboard -Raw).tostring().replace(\"`r\", \"\"))| tmux load-buffer -; tmux paste-buffer"
{{- else if eq .chezmoi.os "darwin" }}
bind-key -T copy-mode-vi p run "pbpaste | tmux load-buffer -; tmux paste-buffer"
{{- else }}
bind-key -T copy-mode-vi p run "{ wl-paste --no-newline 2>/dev/null || xclip -o -selection clipboard; } | tmux load-buffer -; tmux paste-buffer"
{{- end }}

bind-key r source-file ~/.tmux.conf\; display 'Reloaded tmux config.'
# Pick or create a project or SSH session (see ~/.local/bin/tm)
bind-key f display-popup -E -w 80% -h 60% tm
bind-key b switch-client -l
# Cheat sheet; the full key list is :list-keys
bind-key ? display-popup -T " cheat sheet " -w 94 -h 17 "cat ~/.config/tmux/cheatsheet.txt"

# SSH sessions from tm hide this tmux's status bar and use C-b as its prefix,
# leaving C-a to the remote tmux. Say so when entering one.
set-hook -g client-session-changed { if -F '#{@ssh}' { display-message -d 4000 '#S · this tmux is C-b here: C-b f sessions · C-b b back · C-b ? help' } }
set-hook -g client-attached { if -F '#{@ssh}' { display-message -d 4000 '#S · this tmux is C-b here: C-b f sessions · C-b b back · C-b ? help' } }

set -g mode-keys vi
set -g status-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line

set -g status-fg white
set -g status-bg black
set -g status-interval 1
# Dark red status bar when tmux runs as root
if -F '#{==:#{uid},0}' 'set -g status-bg colour52'

# Mark the hostname when this tmux was started from an SSH login (see ~/.zlogin)
if-shell '[ -n "$SSH_CONNECTION" ]' 'set -g @ssh_marker "ssh "' 'set -g @ssh_marker ""'

# Name the outer terminal after this host, so a tmux running SSH into this one
# can show it on the window tab (see window-status-format below)
set -g set-titles on
set -g set-titles-string "#h"

{{- $off := "#{?#{==:#{client_key_table},off},#[fg=black#,bg=yellow] OFF ,}" }}
{{- /* tmux-mode-indicator shows SYNC itself in the full profile */}}
{{- $sync := "#{?synchronize-panes,#[fg=white#,bg=red#,bold] SYNC #[default],}" }}
{{- if eq .profile "minimal" }}
set -g status-left "{{ $off }}{{ $sync }}#[fg=black,bg=red] #S #[fg=red,bg=black]"
{{- else }}
set -g status-left "{{ $off }}#{tmux_mode_indicator}#[fg=black,bg=red] #S #[fg=red,bg=black]"
{{- end }}
set -g status-left-length 40
{{- /* A dim tip that changes every 10 minutes on wide terminals; :set @tips off hides it */}}
{{- $tip := "#{?#{&&:#{!=:#{@tips},off},#{e|>=:#{client_width},170}},#[fg=colour240]#(~/.config/tmux/tip.sh)  ,}" }}
{{- $dir := printf "#[fg=colour245]#{=/-40/…:#{s|^%s|~|:pane_current_path}} " .chezmoi.homeDir }}
{{- $host := printf "#[fg=black,bg=%s,bold] #{@ssh_marker}#h " $hostColor }}
{{- if eq .profile "minimal" }}
set -g status-right "{{ $tip }}{{ $dir }}#[fg={{ $hostColor }},bg=black]{{ $host }}"
{{- else }}
# You need CMake for status below to work!
set -g status-right "{{ $tip }}{{ $dir }}#[fg=blue,bg=black]#[fg=black,bg=blue] #(~/.tmux/plugins/tmux-mem-cpu-load/tmux-mem-cpu-load --interval 1) #[fg={{ $hostColor }},bg=blue]{{ $host }}"
{{- end }}
set -g status-right-length 180
set -g status-justify centre
# Windows running ssh show the remote host's title instead of "ssh"
{{- $name := "#{?#{&&:#{==:#{pane_current_command},ssh},#{!=:#{pane_title},#{host}}},#{pane_title},#W}" }}
set -g window-status-format " #I:{{ $name }}#{?window_flags,#{window_flags}, } "
set -g window-status-current-format " #I:{{ $name }}#{?window_flags,#{window_flags}, } "
set -g window-status-style fg=green,bg=black
set -g window-status-current-style fg=black,bg=green
set -g window-status-separator ""
{{- if ne .profile "minimal" }}

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
{{- end }}

# Ctrl+L now moves between panes, so prefix Ctrl+L clears the screen. This
# comes after tpm because tmux-pain-control binds prefix C-l too.
bind C-l send-keys C-l
