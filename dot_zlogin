# Autostart tmux on interactive SSH logins, unless we're already inside tmux.
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" && -o interactive && "$TERM" != dumb ]] && (( $+commands[tmux] )); then
  # Don't autostart again from a shell that tmux itself started.
  if [[ "$ZSH_TMUX_AUTOSTARTED" != "true" ]]; then
    export ZSH_TMUX_AUTOSTARTED=true
    # Always the main session, not tm's picker: tm's SSH sessions expect it.
    # Only exit if tmux ran; if it failed, stay in a plain shell.
    command tmux -u new-session -A -s main && exit
  fi
fi
